# ─── LLM ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
# (Anthropic opcional, fallback)
ANTHROPIC_API_KEY=

# ─── Postgres / Supabase ────────────────────────────────────────────────────
# Mesma instância serve aos dois agentes — schemas distintos (avos / avos_sessao)
DATABASE_URL=postgresql://user:pass@host:5432/postgres
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=...

# ─── Lyn CRM (compartilhado) ────────────────────────────────────────────────
CRM_BASE_URL=https://ffmpeg-lyn-crm-backend.dewwpd.easypanel.host/api
CRM_API_KEY=lyn_...
CRM_COMPANY_ID=

# Pipelines podem ser distintos por agente
CRM_PIPELINE_ID_SOCIALIA=
CRM_STAGE_INICIAL_ID_SOCIALIA=
CRM_PIPELINE_ID_SESSAO=
CRM_STAGE_INICIAL_ID_SESSAO=

# ─── Instagram / Meta (compartilhado — mesma conta IG, mesmo App) ───────────
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=token_verificacao_customizado
INSTAGRAM_ACCOUNT_ID=

# ─── Servidor unificado ─────────────────────────────────────────────────────
WEBHOOK_PORT=3001
NODE_ENV=development

# Token compartilhado com n8n/Lyn pra autenticar POST /agent/process
AGENT_PROCESS_TOKEN=

# ─── Comportamento dos agentes ──────────────────────────────────────────────
# SocialIA: se true, só responde @s presentes em public.disparos_enviados.
# Sessão: o roteamento já filtra pela whitelist sessao_estrategica antes.
WHITELIST_ENABLED_SOCIALIA=false
WHITELIST_ENABLED_SESSAO=true

INTER_MSG_DELAY_MS=1200
HUMAN_TAKEOVER_PAUSE_MS=86400000

# Janela de debounce: mensagens do MESMO lead em até X ms são combinadas
# numa só (evita resposta dupla quando o lead manda várias DMs quebradas).
# Default 30s. Lead manda 1 msg → espera 30s → agente responde.
MESSAGE_BUFFER_MS=30000

# ─── Branding (compartilhado entre os dois agentes) ─────────────────────────
AGENT_NAME=Felipe
AGENT_CARGO=SDR / Estrategista de IA
AGENT_COMPANY=Neuronex
COMPANY_SITE=www.neuronex.com.br
FORMS_URL=https://forms.gle/COLE-AQUI-SEU-FORMS

# ─── Específico SocialIA ────────────────────────────────────────────────────
SOCIALIA_SIGNUP_URL=https://social-ia-azure.vercel.app/

# ─── Específico Sessão Estratégica (Google Calendar) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/oauth2callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
SESSAO_HORARIO_INICIO=10
SESSAO_HORARIO_FIM=19
SESSAO_DURACAO_MIN=35
